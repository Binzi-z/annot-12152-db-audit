      {
       "id": "cwe-89",
       "name": "sql-injection",
       "shortDescription": {
        "text": "SQL 注入：未净化的用户输入进入 SQL 查询"
       }
      },
      {
       "id": "cwe-78",
       "name": "command-injection",
       "shortDescription": {
        "text": "命令注入：未净化的用户输入进入命令执行"
       }
